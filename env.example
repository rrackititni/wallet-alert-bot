# Discord webhook URL — Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Optional: a random string you also enter as the "Authentication Header" when
# creating the Helius webhook. Leave blank to skip this check (fine for personal use).
HELIUS_WEBHOOK_SECRET=

# Set automatically by most hosts (Railway, Render); safe to leave unset locally.
PORT=3000
